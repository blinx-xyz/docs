            "description": "Verify the sender's account on its network: {accountIdentifier, networkId, country?} → {data: {success, accountName?}}. A mobile number (+) on a bank network is a 400. Sandbox: 0000000000 / 1111111111 always verify.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountIdentifier\": \"1111111111\",\n  \"networkId\": \"{{source_network_id}}\",\n  \"country\": \"{{receive_country}}\"\n}",
              "options": {
