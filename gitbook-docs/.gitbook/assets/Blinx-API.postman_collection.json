            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the first network of send_channel as the send destination network.",
                  "try {",
                  "  const list = pm.response.json().data || [];",
                  "  const channel = pm.collectionVariables.get(\"send_channel\") || \"bank\";",
