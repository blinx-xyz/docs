      "item": [
        {
          "name": "create payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ─────────────────────────────────────────────────────────────────────────────\n// Blinx — Postman POST-RESPONSE script\n// Grabs response.data.redirectUrl and offers a one-click \"Copy\" in the Visualize tab.\n//\n// Paste into the request's \"Scripts → Post-response\" tab (older UI: \"Tests\").\n//\n// Why a button: Postman's sandbox has no OS clipboard access, and browsers only\n// allow a clipboard write on a real click — so the copy happens when you press\n// the button in the Visualize tab. The value is also saved to the `redirectUrl`\n// variable and logged to the console for use without clicking.\n// ─────────────────────────────────────────────────────────────────────────────\n\nlet redirectUrl;\ntry {\n  const body = pm.response.json();\n  redirectUrl = body && body.data ? body.data.redirectUrl : undefined;\n  payment_id = body && body.data ? body.data.id : undefined;\n} catch (e) {\n  console.log('Response is not JSON:', e.message);\n}\n\nif (!redirectUrl) {\n  console.log('No data.redirectUrl in the response.');\n  pm.visualizer.set('<p style=\"font-family:sans-serif;color:#b00\">No <code>data.redirectUrl</code> in the response.</p>');\n} else {\n  // Save + log so it is usable without opening the Visualize tab.\n  pm.environment.set('redirectUrl', redirectUrl);\n  pm.variables.set('redirectUrl', redirectUrl);\n  console.log('redirectUrl:', redirectUrl);\n\n  const parts = redirectUrl.split('/')\n  const payment_code = parts[parts.length-1]\n  pm.collectionVariables.set(\"payment_id\", payment_id);\n  pm.collectionVariables.set(\"payment_code\", payment_code);\n  console.log('payment_id:', payment_id, pm.collectionVariables.get(\"payment_id\"));\n\n  const template = `\n    <div style=\"font-family:sans-serif;font-size:13px\">\n      <input id=\"u\" style=\"width:100%;box-sizing:border-box;padding:8px\" value=\"{{url}}\" readonly>\n      <div style=\"margin-top:8px\">\n        <button id=\"b\" style=\"padding:8px 14px;cursor:pointer\">Copy redirectUrl</button>\n        <a href=\"{{url}}\" target=\"_blank\" rel=\"noopener\" style=\"margin-left:10px\">Open ↗</a>\n        <span id=\"s\" style=\"margin-left:10px;color:#080\"></span>\n      </div>\n    </div>\n    <script>\n      document.getElementById('b').addEventListener('click', function () {\n        var el = document.getElementById('u');\n        var ok = function () { document.getElementById('s').textContent = 'Copied!'; };\n        var viaExec = function () {\n          el.focus(); el.select();\n          try { if (document.execCommand('copy')) return ok(); } catch (e) {}\n          document.getElementById('s').textContent = 'Press Ctrl/Cmd+C';\n        };\n        if (navigator.clipboard && navigator.clipboard.writeText) {\n          navigator.clipboard.writeText(el.value).then(ok, viaExec);\n        } else {\n          viaExec();\n        }\n      });\n    </script>\n  `;\n  pm.visualizer.set(template, { url: redirectUrl });\n}\n"
                ]
              }
            }
          ],
