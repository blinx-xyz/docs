                  "  if (pick) {",
                  "    pm.collectionVariables.set(\"destination_network_id\", pick.networkId);",
                  "    console.log(\"destination_network_id:\", pick.networkId, pick.name, pick.channel);",
                  "  }",
                  "} catch (e) {",
                  "  console.log(\"Response is not JSON:\", e.message);",
                  "}"
                ]
              }
            }
