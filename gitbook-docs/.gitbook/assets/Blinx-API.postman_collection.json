    {
      "name": "receive",
      "description": "Receive funds from a third-party sender: quote → networks → verification → receive → get receive / status. Set receive_country / receive_currency / receive_channel first.",
      "item": [
        {
          "name": "quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{sandbox_url}}/api/merchant/quote",
              "host": [
                "{{sandbox_url}}"
              ],
              "path": [
                "api",
                "merchant",
                "quote"
              ]
            },
            "description": "Step 1 of a receive: quote what the sender pays in their fiat (amountIn, in receive_currency) against the USD you receive. Send amountOut instead to fix the USD you want. The script saves amountIn / amountOut / rate for the receive request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountIn\": \"5000\",\n  \"currencyIn\": \"{{receive_currency}}\",\n  \"currencyOut\": \"USD\",\n  \"country\": \"{{receive_country}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the quote's figures for the following request.",
                  "try {",
                  "  const q = pm.response.json().data;",
                  "  if (q) {",
                  "    pm.collectionVariables.set(\"receive_amount_in\", q.amountIn);",
                  "    pm.collectionVariables.set(\"receive_amount_out\", q.amountOut);",
                  "    pm.collectionVariables.set(\"receive_rate\", q.rate);",
                  "    console.log(\"receive quote:\", q.amountIn, q.currencyIn, \"->\", q.amountOut, q.currencyOut, \"@\", q.rate);",
                  "  }",
                  "} catch (e) {",
                  "  console.log(\"Response is not JSON:\", e.message);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "networks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sandbox_url}}/api/merchant/network/{{receive_country}}",
              "host": [
                "{{sandbox_url}}"
              ],
              "path": [
                "api",
                "merchant",
                "network",
                "{{receive_country}}"
              ]
            },
            "description": "Bank / mobile-money networks a sender in receive_country can pay from. The post-response script stores the first network of receive_channel in {{source_network_id}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Stores the first network of the receive channel as the receive source network.",
                  "try {",
                  "  const body = pm.response.json();",
                  "  const channel = pm.collectionVariables.get(\"receive_channel\") || \"bank\";",
                  "  const list = body && Array.isArray(body.data) ? body.data : [];",
                  "  const pick = list.find((n) => n.channel === channel && n.networkId) || list.find((n) => n.networkId);",
                  "  if (pick) {",
                  "    pm.collectionVariables.set(\"source_network_id\", pick.networkId);",
                  "    console.log(\"source_network_id:\", pick.networkId, pick.name, pick.channel);",
                  "  }",
                  "} catch (e) {",
                  "  console.log(\"Response is not JSON:\", e.message);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
