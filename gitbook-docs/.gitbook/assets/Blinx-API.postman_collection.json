        {
          "name": "receive",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{sandbox_url}}/api/merchant/receive",
              "host": [
                "{{sandbox_url}}"
              ],
              "path": [
                "api",
                "merchant",
                "receive"
              ]
            },
            "description": "Create a receive (KYB + KYC required). amountIn / amountOut / rate come from the quote request; settles in USDC to the vault address (currencyOut ignored). source = {accountName, accountIdentifier, networkId}. Returns {data: {id, bankInfo?}} — bankInfo only for a bank collection. The post-response script stores {{receive_id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountIn\": \"{{receive_amount_in}}\",\n  \"currencyIn\": \"{{receive_currency}}\",\n  \"amountOut\": \"{{receive_amount_out}}\",\n  \"rate\": \"{{receive_rate}}\",\n  \"country\": \"{{receive_country}}\",\n  \"reference\": \"{{$randomUUID}}\",\n  \"memo\": \"{{$randomBsNoun}}\",\n  \"source\": {\n    \"accountName\": \"Ken Adams\",\n    \"accountIdentifier\": \"1111111111\",\n    \"networkId\": \"{{source_network_id}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Stores the receive id for the get receive / get receive status requests.",
                  "try {",
                  "  const body = pm.response.json();",
                  "  const data = body && body.data;",
                  "  if (data && data.id) {",
                  "    pm.collectionVariables.set(\"receive_id\", data.id);",
                  "    console.log(\"receive_id:\", data.id, \"bankInfo:\", JSON.stringify(data.bankInfo || null));",
                  "  } else {",
                  "    console.log(\"No data.id in the response.\");",
                  "  }",
                  "} catch (e) {",
                  "  console.log(\"Response is not JSON:\", e.message);",
                  "}"
                ]
              }
            }
          ]
        },
